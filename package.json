{
  "name": "erp-api",
  "version": "1.0.0",
  "type": "module",
  "description": "Portfolio-grade modular monolith ERP REST API",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "worker": "node src/worker.js",
    "migrate": "node-pg-migrate up",
    "migrate:test": "NODE_ENV=test node-pg-migrate up",
    "lint": "eslint src/ tests/",
    "test": "node --test tests/**/*.test.js",
    "test:unit": "node --test 'tests/unit/**/*.test.js'",
    "test:integration": "node --test 'tests/integration/**/*.test.js'",
    "test:e2e": "node --test 'tests/e2e/**/*.test.js'",
    "test:security": "node --test 'tests/security/**/*.test.js'",
    "test:concurrency": "node --test 'tests/concurrency/**/*.test.js'",
    "test:architecture": "node --test 'tests/architecture/**/*.test.js'",
    "test:queue": "node --test 'tests/queue/**/*.test.js'"
  },
  "dependencies": {
    "argon2": "^0.40.2",
    "bullmq": "^5.12.0",
    "express": "^4.21.2",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "redis": "^4.7.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "dotenv": "^16.4.7",
    "cors": "^2.8.5",
    "express-validator": "^7.2.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "node-pg-migrate": "^7.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "erp",
    "rest-api",
    "portfolio",
    "oop",
    "postgis"
  ],
  "license": "MIT"
}
