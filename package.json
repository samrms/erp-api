{
  "name": "erp-api",
  "version": "1.0.0",
  "type": "module",
  "description": "Portfolio-grade modular monolith ERP REST API",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "worker": "node src/worker.js",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:test": "NODE_ENV=test node-pg-migrate up",
    "migrate": "node-pg-migrate up",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint --fix src/ tests/",
    "lint:check": "prettier --check .",
    "lint:format": "prettier . --write",
    "test": "ERP_TEST_TEMPLATE=erp_test_template_$$ vitest run",
    "test:watch": "ERP_TEST_TEMPLATE=erp_test_template_$$ vitest",
    "test:unit": "ERP_TEST_TEMPLATE=erp_test_template_$$ vitest run tests/unit",
    "test:integration": "ERP_TEST_TEMPLATE=erp_test_template_$$ vitest run tests/integration",
    "test:architecture": "ERP_TEST_TEMPLATE=erp_test_template_$$ vitest run tests/architecture",
    "test:e2e": "ERP_TEST_TEMPLATE=erp_test_template_$$ vitest run tests/e2e",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build"
  },
  "dependencies": {
    "argon2": "^0.40.2",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "redis": "^4.7.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "node-pg-migrate": "^7.2.0",
    "prettier": "3.9.7",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "erp",
    "rest-api",
    "portfolio",
    "oop",
    "modular-monolith"
  ],
  "license": "MIT"
}
