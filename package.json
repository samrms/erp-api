{
  "name": "erp-api",
  "version": "1.0.0",
  "description": "Minimal ERP REST API - portfolio project",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "lint": "eslint src/",
    "test": "node --test",
    "test:unit": "node --test tests/unit/",
    "test:integration": "node --test tests/integration/",
    "test:e2e": "node --test tests/e2e/",
    "test:security": "node --test tests/security/",
    "db:migrate": "node-pg-migrate up",
    "db:rollback": "node-pg-migrate down",
    "db:seed": "node scripts/seed.js"
  },
  "keywords": [
    "erp",
    "api",
    "rest",
    "portfolio"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "argon2": "^0.41.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.14.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "node-pg-migrate": "^7.0.0"
  }
}
